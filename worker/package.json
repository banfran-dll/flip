{
  "name": "bzflip-data",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cloudflare Worker that collects Hypixel bazaar snapshots into D1 and serves history, baselines and crash alerts",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply bzflip --remote",
    "migrate:local": "wrangler d1 migrations apply bzflip --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
